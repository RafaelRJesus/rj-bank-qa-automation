# Site testado (padrão: produção)
BASE_URL=https://cliente-app-1a979.web.app

# Config pública do app web no Firebase (usada nos testes de API/segurança)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=cliente-app-1a979

# mock: CEP, FIPE e Banco Central simulados (determinístico, padrão)
# live: usa as APIs reais
EXTERNAL_APIS=mock

# Contas de teste em produção. O app exige login: crie uma vez, confirme o
# e-mail e guarde aqui (no CI, como secrets). Não use contas pessoais.
# Gestor: cadastrado pelo admin na tela Gestores.
QA_GESTOR_EMAIL=
QA_GESTOR_SENHA=
# Cliente: conta que se cadastrou sozinha, sem contratos de terceiros.
QA_CLIENTE_EMAIL=
QA_CLIENTE_SENHA=
